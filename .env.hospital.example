# Deployment mode:
# - hospital-external: only the allowlisted HTTPS model service may leave the LAN
# - hospital-offline: model endpoints must resolve to local/private hosts
KH_DEPLOYMENT_MODE=hospital-external
KH_MODEL_PROFILE=geekai
KH_MODEL_HOST_ALLOWLIST=geekai.co

# Bootstrap administrator. Replace the placeholder before first startup.
KH_FEATURE_USER_MANAGEMENT_ADMIN=admin
KH_FEATURE_USER_MANAGEMENT_PASSWORD=<REPLACE_WITH_A_STRONG_PASSWORD>

# Transitional GeekAI model gateway. Never commit the real key.
GEEKAI_API_BASE_URL=https://geekai.co/api/v1
GEEKAI_API_KEY=<REPLACE_WITH_API_KEY>
GEEKAI_CHAT_MODEL=qwen3-vl-flash
GEEKAI_EMBEDDING_MODEL=qwen3-vl-embedding
GEEKAI_RERANK_MODEL=qwen3-rerank

# For the final offline deployment, change the two profile values above to:
# KH_DEPLOYMENT_MODE=hospital-offline
# KH_MODEL_PROFILE=lmstudio
# KH_LOCAL_MODEL_BASE_URL=http://model-gateway:8000/v1
# KH_LOCAL_MODEL_API_KEY=<REPLACE_WITH_INTERNAL_KEY>
# KH_LOCAL_CHAT_MODEL=qwen3-vl
# KH_LOCAL_EMBEDDING_MODEL=qwen3-vl-embedding
# KH_LOCAL_RERANK_URL=http://rerank-service:8001/rerank

# Hospital safety defaults.
KH_ENABLE_MCP=false
KH_ALLOW_REMOTE_HELP=false
KH_ENABLE_URL_UPLOAD=false
KH_ENABLE_AGENT_REASONINGS=false
KH_ENABLE_EXTERNAL_AGENT_TOOLS=false
KH_GRADIO_SHARE=false
KH_ENABLE_FIRST_SETUP=false
KH_ENABLE_ASR=false
USE_LOW_LLM_REQUESTS=true

# Runtime capacity and retention. Adjust after load testing.
KH_DEFAULT_CONCURRENCY_LIMIT=8
KH_QUEUE_MAX_SIZE=64
KH_MAX_THREADS=16
KH_MAX_UPLOAD_SIZE=100mb
KH_ZIP_MAX_FILES=200
KH_ZIP_MAX_SIZE_MB=500
KH_LOG_LEVEL=INFO
KH_LOG_MAX_BYTES=20971520
KH_LOG_BACKUP_COUNT=10
