# Hospital deployment defaults. Copy this file to .env and replace all placeholders.
KH_DEPLOYMENT_MODE=hospital-external
KH_MODEL_PROFILE=geekai
KH_MODEL_HOST_ALLOWLIST=geekai.co

# Bootstrap administrator. The password is only needed to create the first user.
KH_FEATURE_USER_MANAGEMENT=true
KH_FEATURE_USER_MANAGEMENT_ADMIN=admin
KH_FEATURE_USER_MANAGEMENT_PASSWORD=<REPLACE_WITH_A_STRONG_PASSWORD>

# Transitional GeekAI models.
GEEKAI_API_BASE_URL=https://geekai.co/api/v1
GEEKAI_API_KEY=<REPLACE_WITH_API_KEY>
GEEKAI_CHAT_MODEL=qwen3-vl-flash
GEEKAI_CHAT_TIMEOUT=120
GEEKAI_EMBEDDING_MODEL=qwen3-vl-embedding
GEEKAI_EMBEDDING_BATCH_SIZE=16
GEEKAI_EMBEDDING_TIMEOUT=60
GEEKAI_RERANK_MODEL=qwen3-rerank
GEEKAI_RERANK_TIMEOUT=60

# Final offline profile example:
# KH_DEPLOYMENT_MODE=hospital-offline
# KH_MODEL_PROFILE=lmstudio
# KH_LOCAL_MODEL_BASE_URL=http://model-gateway:8000/v1
# KH_LOCAL_MODEL_API_KEY=<REPLACE_WITH_INTERNAL_KEY>
# KH_LOCAL_CHAT_MODEL=qwen3-vl
# KH_LOCAL_EMBEDDING_MODEL=qwen3-vl-embedding
# KH_LOCAL_RERANK_URL=http://rerank-service:8001/rerank
KH_START_LOCAL_RERANK=false
RERANK_MODEL_PATH=models/bge-reranker-v2-m3

# Medical application and access control.
KH_APP_NAME=AI 辅助诊断系统
KH_SHARED_FILE_COLLECTION=true
KH_SUPPORTED_FILE_TYPES=.pdf, .txt, .md, .doc, .docx, .xls, .xlsx, .csv
KH_FILE_LOADER_MODES=default
KH_ENABLE_MCP=false
KH_ALLOW_REMOTE_HELP=false
KH_ENABLE_URL_UPLOAD=false
KH_WEB_SEARCH_COMMAND=
KH_ENABLE_AGENT_REASONINGS=false
KH_ENABLE_EXTERNAL_AGENT_TOOLS=false
KH_GRADIO_SHARE=false
KH_ENABLE_FIRST_SETUP=false

# Realtime ASR in the chat composer. Mock is for UI acceptance only; replace it
# with an approved internal provider before clinical use.
KH_ENABLE_ASR=true
KH_ASR_PROVIDER=mock
KH_ASR_API_BASE_URL=
KH_ASR_API_KEY=
KH_ASR_MODEL=
KH_ASR_TIMEOUT=60
KH_ASR_MOCK_INTERVAL_SECONDS=0.55
KH_ASR_MOCK_SEED_VOICEPRINTS=true
KH_CHAT_IMAGE_MAX_FILES=4
KH_CHAT_IMAGE_MAX_SIZE_MB=8
KH_CHAT_IMAGE_MAX_PIXELS=25000000

# Optional internal Keycloak SSO. Leave AUTHENTICATION_METHOD empty for local login.
AUTHENTICATION_METHOD=
KEYCLOAK_SERVER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_SECRET=

# Offline resources and runtime limits.
PDFJS_VERSION_DIST=pdfjs-4.0.379-dist
PADDLE_DEVICE=gpu
GRADIO_ANALYTICS_ENABLED=False
HF_DATASETS_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
USE_LOW_LLM_REQUESTS=true
KH_DEFAULT_CONCURRENCY_LIMIT=8
KH_QUEUE_MAX_SIZE=64
KH_MAX_THREADS=16
KH_MAX_UPLOAD_SIZE=100mb
KH_APP_START_TIMEOUT=90
KH_ZIP_MAX_FILES=200
KH_ZIP_MAX_SIZE_MB=500
KH_LOG_LEVEL=INFO
KH_LOG_MAX_BYTES=20971520
KH_LOG_BACKUP_COUNT=10
KH_SQLITE_BUSY_TIMEOUT_MS=30000
