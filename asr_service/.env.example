# Production profile: every model path points to a local directory.
ASR_BACKEND=funasr
ASR_API_KEY=<REPLACE_WITH_A_RANDOM_INTERNAL_KEY>
ASR_HOST=127.0.0.1
ASR_PORT=8002
ASR_DATA_DIR=./data
ASR_OFFLINE=true

# Audio and identity thresholds. Tune with hospital validation data.
ASR_SAMPLE_RATE=16000
ASR_MAX_SPEAKERS=8
ASR_CLUSTER_THRESHOLD=0.62
ASR_VOICEPRINT_THRESHOLD=0.72
ASR_MAX_VOICEPRINT_SECONDS=60

# FunASR + 3D-Speaker profile.
ASR_DEVICE=cpu
ASR_STREAMING_MODEL=./models/streaming-asr
ASR_OFFLINE_MODEL=./models/offline-asr
ASR_VAD_MODEL=./models/vad
ASR_PUNCTUATION_MODEL=./models/punctuation
ASR_SPEAKER_MODEL=./models/speaker
ASR_ENCODER_CHUNK_LOOK_BACK=4
ASR_DECODER_CHUNK_LOOK_BACK=1
